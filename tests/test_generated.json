{
  "version": "0.2",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "unit": "px"
  },
  "grid": {
    "rows": 2,
    "cols": 3,
    "margin": {
      "top": 20,
      "right": 20,
      "bottom": 20,
      "left": 20
    },
    "gutter": {
      "row": 12,
      "col": 12
    }
  },
  "layout": {
    "flow": "left-to-right",
    "algorithm": "dagre"
  },
  "chunks": [
    {
      "chunk_id": "chunk_0_0",
      "grid_area": {
        "row": 0,
        "col": 0
      }
    },
    {
      "chunk_id": "chunk_0_1",
      "grid_area": {
        "row": 0,
        "col": 1
      }
    },
    {
      "chunk_id": "chunk_0_2",
      "grid_area": {
        "row": 0,
        "col": 2
      }
    },
    {
      "chunk_id": "chunk_1_0",
      "grid_area": {
        "row": 1,
        "col": 0,
        "colspan": 2
      }
    },
    {
      "chunk_id": "chunk_1_2",
      "grid_area": {
        "row": 1,
        "col": 2
      }
    }
  ],
  "groups": [
    {
      "group_id": "grp_training",
      "label": "Training at s^th Stage",
      "title": "(a) Training at s^{th} Stage",
      "type": "stage",
      "chunks": [
        "chunk_0_0"
      ],
      "layout_hint": {
        "arrangement": "horizontal",
        "weight": 0.6,
        "area_hint": 0.33
      },
      "description": "CCT 训练核心：包含 FMM 与 KCM 两个子模块生成兼容特征 Z_s^o/Z_s^n，并通过 BCD 与 BAD 两种平衡蒸馏抑制遗忘、提升兼容性；结合 L_new、L_ca、L_er 与权重 α、1-α 得到总损失。"
    },
    {
      "group_id": "grp_transfer",
      "label": "Transfer at s^th Stage",
      "title": "(b) Transfer at s^{th} Stage",
      "type": "stage",
      "chunks": [
        "chunk_0_1"
      ],
      "layout_hint": {
        "arrangement": "horizontal",
        "weight": 0.25,
        "area_hint": 0.33
      },
      "description": "阶段 s 的特征迁移：将 F^{s-1} 与旧图库特征经 CCT 转换为与新模型兼容的 Transferred Feature Set，形成新的 Gallery 特征集合。"
    },
    {
      "group_id": "grp_testing",
      "label": "Testing at s^th Stage",
      "title": "(c) Testing at s^{th} Stage",
      "type": "stage",
      "chunks": [
        "chunk_0_2"
      ],
      "layout_hint": {
        "arrangement": "horizontal",
        "weight": 0.15,
        "area_hint": 0.34
      },
      "description": "阶段 s 的测试：新模型对 Query 提取特征并在当前图库中检索身份，示例输出 ID: 182。"
    },
    {
      "group_id": "grp_strategies",
      "label": "Re-ID Strategies Comparison",
      "title": "Re-ID 策略对比",
      "type": "module",
      "chunks": [
        "chunk_1_0"
      ],
      "layout_hint": {
        "arrangement": "vertical",
        "weight": 0.5,
        "area_hint": 0.5
      },
      "description": "三个场景对比：Feature Replacing、ReID with Re-indexing、ReID without Re-indexing。展示旧图库图像与查询图像在新模型下的处理流程与兼容性差异。"
    },
    {
      "group_id": "grp_privacy",
      "label": "Data Privacy Scenario",
      "title": "Data Privacy",
      "type": "module",
      "chunks": [
        "chunk_1_2"
      ],
      "layout_hint": {
        "arrangement": "vertical",
        "weight": 0.2,
        "area_hint": 0.2
      },
      "description": "数据隐私受限场景：旧图库图像被锁保护，禁止直接复用；仅利用已存在的旧图库特征与新模型对查询特征进行匹配，体现隐私约束下的 Re-ID。"
    }
  ],
  "nodes": [
    {
      "node_id": "node_data_stream",
      "label": "Data Stream",
      "type": "data",
      "group": "grp_training",
      "role": "input",
      "description": "数据流入口，指向旧/新数据以参与 CCT 训练阶段。"
    },
    {
      "node_id": "node_old_data",
      "label": "Old data",
      "type": "data",
      "group": "grp_training",
      "role": "input",
      "description": "历史阶段采集的数据样本，用于保持跨阶段特征兼容与避免遗忘。"
    },
    {
      "node_id": "node_new_data",
      "label": "New data",
      "type": "data",
      "group": "grp_training",
      "role": "input",
      "description": "当前阶段新增的数据样本，用于学习新身份与新分布。"
    },
    {
      "node_id": "node_old_model",
      "label": "Old Model",
      "type": "model",
      "group": "grp_training",
      "role": "reference",
      "description": "上一阶段的模型，用作知识蒸馏与兼容参考来源。"
    },
    {
      "node_id": "node_new_model",
      "label": "New Model",
      "type": "model",
      "group": "grp_training",
      "role": "trainable",
      "description": "当前阶段正在训练的新模型骨干/特征提取器。"
    },
    {
      "node_id": "node_fmm",
      "label": "Forward Mapping Module (FMM)",
      "type": "module",
      "group": "grp_training",
      "role": "process",
      "description": "前向映射模块：将旧/新数据特征映射到兼容表征空间，内部含 BN+PReLU x4、MLP 与 Softmax。"
    },
    {
      "node_id": "node_fmm_bn_prelu",
      "label": "BN + PReLU x4",
      "type": "layer",
      "group": "grp_training",
      "role": "process",
      "description": "四组归一化与激活堆叠，用于稳定与非线性变换。"
    },
    {
      "node_id": "node_fmm_mlp",
      "label": "MLP",
      "type": "layer",
      "group": "grp_training",
      "role": "process",
      "description": "多层感知机，将映射后的特征进一步投影。"
    },
    {
      "node_id": "node_fmm_softmax",
      "label": "Softmax",
      "type": "op",
      "group": "grp_training",
      "role": "process",
      "description": "对 FMM 输出进行归一化，以便与 KCM 输出的兼容特征对齐。"
    },
    {
      "node_id": "node_kcm",
      "label": "Knowledge Capturing Module (KCM)",
      "type": "module",
      "group": "grp_training",
      "role": "process",
      "description": "知识捕获模块：融合 Old/New Model 的输出，通过向量库与子网络挖掘可转移知识。"
    },
    {
      "node_id": "node_kcm_fc",
      "label": "FC",
      "type": "layer",
      "group": "grp_training",
      "role": "process",
      "description": "KCM 中的全连接层，用于特征变换与压缩。"
    },
    {
      "node_id": "node_kcm_subnet",
      "label": "Subnet",
      "type": "module",
      "group": "grp_training",
      "role": "process",
      "description": "KCM 子网络，学习从旧/新模型输出到兼容空间的非线性映射。"
    },
    {
      "node_id": "node_kcm_ki",
      "label": "k_i vectors",
      "type": "data",
      "group": "grp_training",
      "role": "parameter",
      "description": "知识向量集合 k_i，刻画旧模型的结构化知识。"
    },
    {
      "node_id": "node_kcm_ui",
      "label": "u_i vectors",
      "type": "data",
      "group": "grp_training",
      "role": "parameter",
      "description": "知识向量集合 u_i，刻画新模型的结构化知识。"
    },
    {
      "node_id": "node_kcm_sigma",
      "label": "Σ",
      "type": "op",
      "group": "grp_training",
      "role": "process",
      "description": "求和操作，聚合多路知识分量。"
    },
    {
      "node_id": "node_kcm_multiply",
      "label": "Multiply",
      "type": "op",
      "group": "grp_training",
      "role": "process",
      "description": "乘法门控/加权操作，融合不同来源的知识分量。"
    },
    {
      "node_id": "node_zso",
      "label": "Z_s^o",
      "type": "data",
      "group": "grp_training",
      "role": "feature",
      "description": "阶段 s 的旧域兼容特征。"
    },
    {
      "node_id": "node_zsn",
      "label": "Z_s^n",
      "type": "data",
      "group": "grp_training",
      "role": "feature",
      "description": "阶段 s 的新域兼容特征。"
    },
    {
      "node_id": "node_bcd",
      "label": "Balanced Compatible Distillation (BCD)",
      "type": "module",
      "group": "grp_training",
      "role": "loss_module",
      "description": "平衡兼容蒸馏：对 Z_s^o/Z_s^n 关系建模，约束同人/异人相似性，得到兼容性损失 L_ca。"
    },
    {
      "node_id": "node_mo",
      "label": "M^o",
      "type": "data",
      "group": "grp_training",
      "role": "metric",
      "description": "旧域特征相似度矩阵。"
    },
    {
      "node_id": "node_mn",
      "label": "M^n",
      "type": "data",
      "group": "grp_training",
      "role": "metric",
      "description": "新域特征相似度矩阵。"
    },
    {
      "node_id": "node_sim_same",
      "label": "Similarity of Same Person",
      "type": "metric",
      "group": "grp_training",
      "role": "reference",
      "description": "同一身份样本的相似性约束。"
    },
    {
      "node_id": "node_sim_diff",
      "label": "Similarity of Different Person",
      "type": "metric",
      "group": "grp_training",
      "role": "reference",
      "description": "不同身份样本的相似性区分。"
    },
    {
      "node_id": "node_bad",
      "label": "Balanced Anti-forgetting Distillation (BAD)",
      "type": "module",
      "group": "grp_training",
      "role": "loss_module",
      "description": "平衡抗遗忘蒸馏：利用旧/新分类器对齐输出分布，抑制对旧知识的遗忘，得到 L_er。"
    },
    {
      "node_id": "node_old_cls",
      "label": "Old Classifier",
      "type": "layer",
      "group": "grp_training",
      "role": "reference",
      "description": "旧模型的分类头，用作蒸馏教师。"
    },
    {
      "node_id": "node_new_cls",
      "label": "New Classifier",
      "type": "layer",
      "group": "grp_training",
      "role": "trainable",
      "description": "新模型的分类头，用作学生进行蒸馏学习。"
    },
    {
      "node_id": "node_L_ca",
      "label": "L_ca",
      "type": "loss",
      "group": "grp_training",
      "role": "output",
      "description": "兼容性蒸馏损失，来自 BCD。"
    },
    {
      "node_id": "node_L_er",
      "label": "L_er",
      "type": "loss",
      "group": "grp_training",
      "role": "output",
      "description": "抗遗忘蒸馏损失，来自 BAD。"
    },
    {
      "node_id": "node_L_new",
      "label": "L_new",
      "type": "loss",
      "group": "grp_training",
      "role": "output",
      "description": "新数据监督损失，用于学习新身份。"
    },
    {
      "node_id": "node_alpha",
      "label": "α",
      "type": "param",
      "group": "grp_training",
      "role": "weight",
      "description": "损失平衡因子，用于加权兼容性项。"
    },
    {
      "node_id": "node_one_minus_alpha",
      "label": "1-α",
      "type": "param",
      "group": "grp_training",
      "role": "weight",
      "description": "损失平衡因子，抑制遗忘项的权重。"
    },
    {
      "node_id": "node_mult_ca",
      "label": "Multiply (α·L_ca)",
      "type": "op",
      "group": "grp_training",
      "role": "process",
      "description": "对兼容性损失进行 α 加权。"
    },
    {
      "node_id": "node_mult_er",
      "label": "Multiply ((1-α)·L_er)",
      "type": "op",
      "group": "grp_training",
      "role": "process",
      "description": "对抗遗忘损失进行 (1-α) 加权。"
    },
    {
      "node_id": "node_sum_loss",
      "label": "Sum",
      "type": "op",
      "group": "grp_training",
      "role": "process",
      "description": "对各项损失进行求和组合。"
    },
    {
      "node_id": "node_total_loss",
      "label": "Total Loss",
      "type": "loss",
      "group": "grp_training",
      "role": "output",
      "description": "训练阶段的最终优化目标。"
    },
    {
      "node_id": "node_prev_feature",
      "label": "F^{s-1}",
      "type": "data",
      "group": "grp_transfer",
      "role": "input",
      "description": "上一阶段生成的特征表示。"
    },
    {
      "node_id": "node_old_gallery_set",
      "label": "Old Gallery Feature Set",
      "type": "data",
      "group": "grp_transfer",
      "role": "input",
      "description": "历史图库的特征集合，需要被迁移以保持兼容。"
    },
    {
      "node_id": "node_cct_transfer",
      "label": "CCT at s^{th} Stage",
      "type": "module",
      "group": "grp_transfer",
      "role": "process",
      "description": "在阶段 s 应用 CCT，将旧阶段/旧图库特征映射为与新模型兼容的表征。"
    },
    {
      "node_id": "node_transferred_set",
      "label": "Transferred Feature Set",
      "type": "data",
      "group": "grp_transfer",
      "role": "output",
      "description": "通过 CCT 变换后的兼容特征集合。"
    },
    {
      "node_id": "node_new_gallery_set",
      "label": "New Gallery Feature Set",
      "type": "data",
      "group": "grp_transfer",
      "role": "output",
      "description": "更新后的图库特征集合，供阶段 s 测试使用。"
    },
    {
      "node_id": "node_fs",
      "label": "F^s",
      "type": "data",
      "group": "grp_testing",
      "role": "input",
      "description": "阶段 s 的当前特征空间/图库特征。"
    },
    {
      "node_id": "node_query",
      "label": "Query",
      "type": "data",
      "group": "grp_testing",
      "role": "input",
      "description": "查询行人图像。"
    },
    {
      "node_id": "node_new_model_test",
      "label": "New Model",
      "type": "model",
      "group": "grp_testing",
      "role": "inference",
      "description": "阶段 s 的新模型，用于测试期特征提取。"
    },
    {
      "node_id": "node_extracted_features",
      "label": "Extracted Features",
      "type": "data",
      "group": "grp_testing",
      "role": "output",
      "description": "由新模型提取的查询特征。"
    },
    {
      "node_id": "node_id182",
      "label": "ID: 182",
      "type": "label",
      "group": "grp_testing",
      "role": "output",
      "description": "示例检索结果身份标签。"
    },
    {
      "node_id": "node_old_gallery_images",
      "label": "Old Gallery Images",
      "type": "data",
      "group": "grp_strategies",
      "role": "input",
      "description": "历史图库原始图像集合。"
    },
    {
      "node_id": "node_query_images",
      "label": "Query Images",
      "type": "data",
      "group": "grp_strategies",
      "role": "input",
      "description": "用于检索的查询图像集合。"
    },
    {
      "node_id": "node_fr_old_gallery_features",
      "label": "Old Gallery Features",
      "type": "data",
      "group": "grp_strategies",
      "role": "reference",
      "description": "Feature Replacing 策略中保持不变的旧图库特征。"
    },
    {
      "node_id": "node_fr_new_model",
      "label": "New Model",
      "type": "model",
      "group": "grp_strategies",
      "role": "inference",
      "description": "用于 Feature Replacing 策略的查询特征提取。"
    },
    {
      "node_id": "node_fr_query_features",
      "label": "Query Features",
      "type": "data",
      "group": "grp_strategies",
      "role": "output",
      "description": "由新模型提取的查询特征（Feature Replacing）。"
    },
    {
      "node_id": "node_fr_note",
      "label": "Compatibility Issue",
      "type": "note",
      "group": "grp_strategies",
      "role": "warning",
      "description": "新旧特征空间不兼容的风险提示（Feature Replacing）。"
    },
    {
      "node_id": "node_reidx_module",
      "label": "Re-indexing",
      "type": "module",
      "group": "grp_strategies",
      "role": "process",
      "description": "对旧图库图像进行重新索引/重提特征以适配新模型。"
    },
    {
      "node_id": "node_reidx_gallery_features",
      "label": "Re-indexed Gallery Features",
      "type": "data",
      "group": "grp_strategies",
      "role": "output",
      "description": "经重新索引后的图库特征，与新模型兼容。"
    },
    {
      "node_id": "node_reidx_new_model",
      "label": "New Model",
      "type": "model",
      "group": "grp_strategies",
      "role": "inference",
      "description": "用于 Re-indexing 策略中提取查询特征。"
    },
    {
      "node_id": "node_reidx_query_features",
      "label": "Query Features",
      "type": "data",
      "group": "grp_strategies",
      "role": "output",
      "description": "查询图像在 Re-indexing 策略下的特征表示。"
    },
    {
      "node_id": "node_wo_old_gallery_features",
      "label": "Old Gallery Features",
      "type": "data",
      "group": "grp_strategies",
      "role": "reference",
      "description": "未重新索引情况下直接使用的旧图库特征。"
    },
    {
      "node_id": "node_wo_new_model",
      "label": "New Model",
      "type": "model",
      "group": "grp_strategies",
      "role": "inference",
      "description": "用于 w/o Re-indexing 策略的查询特征提取。"
    },
    {
      "node_id": "node_wo_query_features",
      "label": "Query Features",
      "type": "data",
      "group": "grp_strategies",
      "role": "output",
      "description": "未重新索引策略下的查询特征。"
    },
    {
      "node_id": "node_wo_note",
      "label": "Compatibility Issue",
      "type": "note",
      "group": "grp_strategies",
      "role": "warning",
      "description": "新旧特征空间不兼容的风险提示（w/o Re-indexing）。"
    },
    {
      "node_id": "node_privacy_lock",
      "label": "Lock",
      "type": "icon",
      "group": "grp_privacy",
      "role": "constraint",
      "description": "红色锁图标，表示数据隐私保护与访问限制。"
    },
    {
      "node_id": "node_dp_old_gallery_images_locked",
      "label": "Old Gallery Images (Locked)",
      "type": "data",
      "group": "grp_privacy",
      "role": "input",
      "description": "受隐私保护的旧图库图像，禁止直接使用。"
    },
    {
      "node_id": "node_dp_new_model",
      "label": "New Model",
      "type": "model",
      "group": "grp_privacy",
      "role": "inference",
      "description": "在隐私约束下对查询图像提取特征。"
    },
    {
      "node_id": "node_dp_query_images",
      "label": "Query Images",
      "type": "data",
      "group": "grp_privacy",
      "role": "input",
      "description": "隐私场景下的查询图像输入。"
    },
    {
      "node_id": "node_dp_query_features",
      "label": "Query Features",
      "type": "data",
      "group": "grp_privacy",
      "role": "output",
      "description": "由新模型提取的查询特征（隐私受限）。"
    },
    {
      "node_id": "node_dp_old_gallery_features",
      "label": "Old Gallery Features",
      "type": "data",
      "group": "grp_privacy",
      "role": "reference",
      "description": "已存在的旧图库特征（来源受限），可用于检索但不可反向追溯到原始图像。"
    }
  ],
  "edges": [
    {
      "edge_id": "e_ds_old",
      "source": "node_data_stream",
      "target": "node_old_data",
      "type": "data",
      "route_hint": "straight",
      "description": "数据流指向旧数据。"
    },
    {
      "edge_id": "e_ds_new",
      "source": "node_data_stream",
      "target": "node_new_data",
      "type": "data",
      "route_hint": "straight",
      "description": "数据流指向新数据。"
    },
